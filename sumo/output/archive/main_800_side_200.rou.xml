<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <vType id="car" accel="2.6" decel="4.5" length="5.0" maxSpeed="30.0" sigma="0.5"/>

    <route id="main_route" edges="main_in out"/>
    <route id="side_route" edges="side_in out"/>

    <flow id="main_flow" type="car" route="main_route" begin="0" end="1200.0" period="4.500000" departLane="free" departSpeed="max"/>
    <flow id="side_flow" type="car" route="side_route" begin="0" end="1200.0" period="18.000000" departLane="free" departSpeed="max"/>
</routes>
